# Database connection string
DATABASE_URL=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/your-db-name?retryWrites=true&w=majority

# Payload secret (used for cookie sessions and encryption)
PAYLOAD_SECRET=your-random-long-secret-here

# Public URL of the CMS (e.g., https://your-cms.koyeb.app)
# Do NOT include a trailing slash
PAYLOAD_PUBLIC_SERVER_URL=http://localhost:3000

# Public URL of the frontend (e.g., https://your-site.pages.dev)
PAYLOAD_PUBLIC_SITE_URL=http://localhost:3001

# Cloudinary credentials for persistent media storage
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
CLOUDINARY_FOLDER=machi11
