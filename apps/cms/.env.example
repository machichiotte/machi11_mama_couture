# Database connection string
DATABASE_URL=mongodb://localhost:27011/machi11_petit_point

# Payload secret (used for cookie sessions and encryption)
PAYLOAD_SECRET=your-random-long-secret-here

# Do NOT include a trailing slash
PORT=4011
PAYLOAD_PUBLIC_SERVER_URL=http://localhost:4011
NEXT_PUBLIC_PAYLOAD_SERVER_URL=http://localhost:4011

# Public URL of the frontend
PAYLOAD_PUBLIC_SITE_URL=http://localhost:3011

# Cloudinary credentials for persistent media storage
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
CLOUDINARY_FOLDER=machi11

# SMTP Configuration for real email sending
# Leave empty or provide host to activate
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=votre-email@gmail.com
SMTP_PASS=votre-mot-de-passe-d-application
SMTP_FROM_NAME=Atelier Petit Point
SMTP_FROM_ADDRESS=atelier@petit-point.fr
