{
  "name": "machi11_mama_couture",
  "version": "0.1.0",
  "private": true,
  "description": "Headless CMS foundation for creative businesses",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "pnpm run dev --filter cms",
    "build": "pnpm run build --recursive",
    "lint": "pnpm run lint --recursive",
    "generate:types": "pnpm run generate:types --filter cms",
    "lint:fix": "pnpm run lint --recursive -- --fix",
    "db:dev": "docker compose -f docker-compose.dev.yml up -d",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "prepare": "husky || true"
  },
  "lint-staged": {
    "apps/web/**/*.{js,ts,vue}": "npm run lint --workspace=web",
    "apps/cms/**/*.{js,ts}": "npm run lint --workspace=cms"
  },
  "keywords": [
    "payloadcms",
    "nuxt",
    "cms",
    "headless"
  ],
  "author": "Machi",
  "license": "MIT",
  "devDependencies": {
    "concurrently": "^9.2.1",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.7"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "sharp",
      "esbuild",
      "unrs-resolver"
    ]
  }
}