{
  "name": "machi11_mama_couture",
  "version": "0.1.0",
  "private": true,
  "description": "Headless CMS foundation for creative businesses",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "pnpm --filter cms dev",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "generate:types": "pnpm --filter cms generate:types",
    "lint:fix": "pnpm -r lint -- --fix",
    "db:dev": "docker compose -f docker-compose.dev.yml up -d",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "prepare": "husky || true"
  },
  "lint-staged": {
    "apps/cms/**/*.{js,ts}": "pnpm --filter cms lint"
  },
  "keywords": [
    "payloadcms",
    "nuxt",
    "cms",
    "headless"
  ],
  "author": "Machi",
  "license": "MIT",
  "devDependencies": {
    "concurrently": "^9.2.1",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.7"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "sharp",
      "esbuild",
      "unrs-resolver"
    ]
  }
}